PORT=3000

# Launcher setup wizard version. `npm start` runs setup when this is missing/outdated.
SETUP_VERSION=

# Optional. Neu bo trong, launcher dung thu muc hien tai lam workspace ban dau.
# WORKSPACE_PATH=D:\Coding\my-app

# Them project khac (phan cach bang ; tren Windows)
# EXTRA_WORKSPACE_PATHS=D:\Coding\other-repo

# slim = bo tool cho ChatGPT web; full = tat ca tools.
CHATGPT_TOOL_PROFILE=slim

# Post-edit hooks (php -l, node --check sau khi sua file)
# POST_EDIT_HOOKS_CONFIG=profiles/post-edit-hooks.json

# Shell cwd luu giua cac tool call ChatGPT
# MCP_SHELL_STATE_DIR=.mcp-state

# Gioi han noi dung CLAUDE.md inject vao MCP instructions (mac dinh ~25KB)
# PROJECT_MEMORY_MAX_BYTES=25000
# PROJECT_MEMORY_MAX_LINES=200

# User memory (tu dong load neu ton tai):
#   %USERPROFILE%\.codex\CLAUDE.md  hoac  %USERPROFILE%\.claude\CLAUDE.md

# Quyen do Workbench kiem soat; annotations phan anh dung tac dong cua tool.
WORKBENCH_DEFAULT_MODE=ask
# State va credentials mac dinh o %USERPROFILE%\.chatgpt-local-coder\workbench
# WORKBENCH_PATH=D:\LocalCoderState

# Workspace-only OS process sandbox (Docker Desktop / Docker Engine).
# Opt-in ro rang: server KHONG tu pull image. Chay `docker pull node:22-bookworm` truoc.
# Khi bat, shell va local Git chay voi workspace mount rw, network=none, non-root,
# cap-drop=ALL va resource limits. GitHub, remote Git, upstream MCP va Preview start
# van can machine scope vi sandbox co tinh khong co network/host port.
# WORKBENCH_SANDBOX_PROVIDER=docker
# WORKBENCH_SANDBOX_IMAGE=node:22-bookworm
# WORKBENCH_SANDBOX_USER=65534:65534
# WORKBENCH_SANDBOX_MEMORY_MB=1536
# WORKBENCH_SANDBOX_PIDS=256
# WORKBENCH_SANDBOX_CPUS=2
# WORKBENCH_SANDBOX_DOCKER_BIN=docker

# PUBLIC_BASE_URL phai trung HTTPS origin cua tunnel, khong co /mcp.
# PUBLIC_BASE_URL=https://your-stable-tunnel.example
# Them callback OAuth chinh xac neu connector yeu cau; phan cach bang ;.
# OAUTH_REDIRECT_URIS=https://chatgpt.com/connector/oauth/your-callback-id

SHELL_TIMEOUT=120
AUDIT_LOG_PATH=.mcp-audit.log

# Checkpoint / rewind (Claude Code-style code undo)
CHECKPOINT_ENABLED=true
CHECKPOINT_PATH=.mcp-checkpoints
CHECKPOINT_MAX_COUNT=500
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_MAX_FILE_BYTES=5242880

# Admin GUI (localhost-only)
ADMIN_PORT=3001
ADMIN_TOKEN=
# Neu de trong, server tao admin token va MCP token trong credentials.json.
# ChatGPT dung OAuth; MCP_AUTH_TOKEN danh cho client ho tro bearer header.
MCP_AUTH_TOKEN=

# Upstream MCP hub config
MCP_UPSTREAM_CONFIG=profiles/mcp-upstream.json

# MCP session stability (tranh loi "luong tin nhan" khi ChatGPT reconnect)
MCP_SESSION_RECOVERY=true
MCP_SESSION_DELETE_GRACE_MS=45000

# OpenAI Secure MCP Tunnel (URL on dinh — chay openai-tunnel-init.bat lan dau)
# Lay tu: https://platform.openai.com/settings/organization/tunnels
# API key: https://platform.openai.com/settings/organization/api-keys (Runtime key)
# `npm start` tu sua tunnel-client neu binary bi mat/hong/sai version.
# `npm run repair:tunnel` chi sua cau hinh tunnel, khong setup lai workspace/UI.
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_API_KEY=
# Optional for organization-scoped tunnels that return tunnel_active_organization_required.
# CONTROL_PLANE_ORGANIZATION_ID=org_...

# Launcher tunnel mode: auto | cloudflare | openai | off
# auto (mac dinh): dung Cloudflare Quick Tunnel neu cloudflared co san.
# openai: chi dung khi ban chu dong chon; ChatGPT connector phai de
# Connection=Tunnel va Authentication=None.
# TUNNEL_MODE=auto